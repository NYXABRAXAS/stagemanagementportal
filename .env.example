# Copy this file to server/.env and adjust. Never commit the real .env file.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/los_stage_portal?schema=public"

# Used only by the automated API tests (a separate, disposable database)
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/los_stage_portal_test?schema=public"

# API server port (the built UI is served from the same port in production)
API_PORT=4000
NODE_ENV=development

# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
SESSION_HOURS=8

# Set to true when the portal is served over HTTPS (office server behind a reverse proxy)
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins in development (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Password for the seeded demo users (local development only).
# If unset, the seed uses the documented local demo password.
SEED_DEMO_PASSWORD=
